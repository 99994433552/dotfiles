# Cloudflare Tunnel Token
# Get your tunnel token from Cloudflare Zero Trust dashboard:
# https://one.dash.cloudflare.com/ > Access > Tunnels > [Your Tunnel] > Configure
TUNNEL_TOKEN=your_tunnel_token_here

# Last.fm Integration (optional)
# Get API key from: https://www.last.fm/api/account/create
LASTFM_APIKEY=your_lastfm_api_key
LASTFM_SECRET=your_lastfm_secret

# Navidrome Configuration
# Public URL for sharing links
NAVIDROME_SHARE_URL=https://navidrome.yourdomain.com

# Path to Navidrome data directory (config, database, cache)
NAVIDROME_DATA_PATH=/path/to/.config/navidrome

# Path to your music library
MUSIC_LIBRARY_PATH=/path/to/music/library

# qBittorrent Configuration
# User/Group ID for file permissions (run `id -u` and `id -g` to get yours)
QBIT_PUID=1000
QBIT_PGID=1000

# Timezone for qBittorrent (e.g., Europe/Kyiv, America/New_York)
TIMEZONE=Europe/Kyiv

# Path to qBittorrent config directory (stores settings, state)
QBIT_CONFIG_PATH=/path/to/.config/qbittorrent

# Path to downloads directory - should be /Volumes/archive/mediaserver
# This allows selecting subdirectories in qBittorrent web UI
QBIT_DOWNLOADS_PATH=/Volumes/archive/mediaserver

# Spotyist Configuration (Spotify library cleanup web app)
# Path to the cloned repo — the build context for the image
SPOTYIST_REPO_PATH=/path/to/spotyist
# Spotify app client ID (public PKCE identifier, no client secret)
SPOTYIST_CLIENT_ID=your_spotify_client_id
# Fernet key that encrypts every stored Spotify token. >= 32 chars
# (openssl rand -hex 32). Reuse the SAME value across hosts/redeploys so
# existing sessions keep working; a new value logs everyone out.
SPOTYIST_SESSION_SECRET=your_session_secret
# Apex domain — the app is served at spotyist.<domain> via the tunnel
SPOTYIST_DOMAIN=yourdomain.com

