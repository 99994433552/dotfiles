# Claude Code local settings
.claude/*.local.json

# Temporary files
*.log
/tmp/

# Backup files
*.bak
CHANGELOG.local.md

# SketchyBar compiled helpers (rebuild with swiftc)
config/sketchybar/helpers/calendar_events
config/sketchybar/helpers/reminder_count
config/sketchybar/helpers/calendars.txt

# Profile-specific files
Brewfile
.dotfiles-profile
config/nvim/lua/current-theme.lua

# Docker Compose secrets
docker-compose/.env
docker-compose/**/.env

# Claude Code (ignore most, but track rules + shared settings)
.claude/*
!.claude/rules/
!.claude/settings.json
!.claude/skills/
!.claude/hooks/
!.claude/SKILLS.md
!.claude/output-styles/

# Brainstorming specs live alongside plans under docs/superpowers/
# (global gitignore excludes any dir named specs/)
!docs/superpowers/specs
!docs/superpowers/specs/**
